# Copy this file to .env and fill in the values. .env is gitignored.
#
# Register a Strava API application at https://www.strava.com/settings/api
# (see docs/strava_setup.md for the walkthrough).
#
# These two secrets are needed only during the one-time OAuth flow run by
# scripts/auth_strava.py. After that, the refresh token in
# ~/.trainingplan/strava_tokens.json is what's used day-to-day.

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Daily training email — Gmail App Password (NOT your regular password).
# Generate one at https://myaccount.google.com → Security → 2-Step Verification
# → App passwords. See docs/email_setup.md for the walkthrough.
EMAIL_PASSWORD=
